# JourneyLab local development — STEP-001.04
# Copy to .env and adjust. NEVER commit .env (see .gitignore).
# These are LOCAL DEVELOPMENT values only and grant no production access.

POSTGRES_USER=journeylab
POSTGRES_PASSWORD=journeylab_dev_only
POSTGRES_DB=journeylab
DATABASE_URL=postgresql://journeylab:journeylab_dev_only@127.0.0.1:5700/journeylab

REDIS_URL=redis://127.0.0.1:5701

MINIO_ROOT_USER=journeylab
MINIO_ROOT_PASSWORD=journeylab_dev_only
S3_ENDPOINT=http://127.0.0.1:5702
S3_CONSOLE=http://127.0.0.1:5703

NATS_URL=nats://127.0.0.1:5704

OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:5705
OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=http://127.0.0.1:5706
JAEGER_UI=http://127.0.0.1:5707

# --- Auth0 (DEC-004 / ADR-013) ------------------------------------------------
# Issuer and client ID are NOT secrets — both appear in the browser during
# sign-in. The client SECRET is a confidential credential: keep it in .env only.
AUTH0_ISSUER=https://<your-tenant>.<region>.auth0.com/
AUTH0_CLIENT_ID=<from Auth0 Application Settings>
AUTH0_CLIENT_SECRET=<from Auth0 Application Settings — never commit>

# HTTPS is required locally, not optional: session cookies use the __Host- prefix
# and browsers only accept those over TLS. Generate the cert once with:
#   brew install mkcert && mkcert -install
#   cd apps/web/certificates && mkcert localhost 127.0.0.1 ::1
AUTH0_REDIRECT_URI=https://localhost:5709/api/auth/callback
