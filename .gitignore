# Knowledge graph index (rebuildable from source)
.gitnexus

# pnpm's content-addressable store, if a developer or container points it inside
# the repository. CI keeps it outside the workspace; a local run may not.
.pnpm-store/

# Tool-private indexes. These are per-machine caches, not shared state: .vexp
# holds a SQLite index (9.2 MB when BUG-014 committed it by accident) plus WAL,
# SHM and lock sidecars that change on every read.
.vexp/

# Dependencies
node_modules/
.venv/
__pycache__/
*.py[cod]

# Build output
dist/
build/
.next/
*.tsbuildinfo

# Test and coverage output
#
# ANCHORED, BECAUSE `coverage/` MATCHES AT ANY DEPTH (BUG-032).
#   An unanchored directory pattern matches everywhere, so plain `coverage/` also
#   ignored `apps/web/src/app/coverage/` — a Next.js ROUTE directory. The files
#   existed on disk, so the local build was fine and the page rendered; `git add -A`
#   silently skipped them, the commit looked complete, and CI built without the page
#   and served 404 to every test.
#
#   Nothing warned. The only signal was a route missing from a build manifest in
#   another machine's log.
/coverage/
apps/*/coverage/
packages/*/coverage/
services/*/coverage/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/

# Environment and secrets — never commit real values
.env
.env.*
!.env.example

# Local TLS material. The __Host- cookie prefix requires HTTPS, so local dev runs
# behind a mkcert certificate. The PRIVATE KEY must never be committed — anyone
# holding it can impersonate localhost for every developer who trusts the CA.
apps/web/certificates/
*.pem
*.key
*.p12
*.pfx

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Playwright accessibility run — STEP-003.08. Traces and reports are per-run
# diagnostics, sometimes tens of MB; BUG-014 was a committed tool artifact.
apps/web/playwright-report/
apps/web/test-results/
