# Knowledge graph index (rebuildable from source)
.gitnexus

# pnpm's content-addressable store, if a developer or container points it inside
# the repository. CI keeps it outside the workspace; a local run may not.
.pnpm-store/

# Tool-private indexes. These are per-machine caches, not shared state: .vexp
# holds a SQLite index (9.2 MB when BUG-014 committed it by accident) plus WAL,
# SHM and lock sidecars that change on every read.
.vexp/

# Dependencies
node_modules/
.venv/
__pycache__/
*.py[cod]

# Build output
dist/
build/
.next/
*.tsbuildinfo

# Test and coverage output
coverage/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/

# Environment and secrets — never commit real values
.env
.env.*
!.env.example

# Local TLS material. The __Host- cookie prefix requires HTTPS, so local dev runs
# behind a mkcert certificate. The PRIVATE KEY must never be committed — anyone
# holding it can impersonate localhost for every developer who trusts the CA.
apps/web/certificates/
*.pem
*.key
*.p12
*.pfx

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
