{
  "name": "@journeylab/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JourneyLab web surface — STEP-002.05 scaffolds auth only; the shell is STEP-003",
  "scripts": {
    "dev": "next dev --port 5709 --experimental-https --experimental-https-key ./certificates/localhost+2-key.pem --experimental-https-cert ./certificates/localhost+2.pem",
    "build": "next build",
    "start": "next start --port 5709",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "a11y": "playwright test"
  },
  "dependencies": {
    "@journeylab/contracts": "workspace:*",
    "@journeylab/ui": "workspace:*",
    "next": "16.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "7.0.2",
    "vitest": "^3.2.0"
  }
}
